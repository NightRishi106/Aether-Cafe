rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Orders Security ---
    match /orders/{orderId} {
      allow get: if isOwner(resource.data.userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidOrder(request.resource.data);
      // No updates or deletes allowed by clients for now (system handles status)
    }

    function isValidOrder(data) {
      return data.userId == request.auth.uid
        && data.items is list
        && data.items.size() > 0
        && data.total is number
        && data.status == 'preparing'
        && data.createdAt == request.time
        && data.keys().hasAll(['userId', 'items', 'total', 'status', 'createdAt'])
        && data.keys().size() >= 5;
    }

    // --- Reservations Security ---
    match /reservations/{reservationId} {
      allow get: if isOwner(resource.data.userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidReservation(request.resource.data);
    }

    function isValidReservation(data) {
      return data.userId == request.auth.uid
        && data.guests is int
        && data.guests >= 1
        && data.guests <= 20
        && data.date is string && data.date.size() <= 20
        && data.time is string && data.time.size() <= 10
        && data.zone is string && data.zone.size() <= 50
        && data.customerName is string && data.customerName.size() <= 100
        && data.customerEmail is string && data.customerEmail.size() <= 100
        && data.status == 'confirmed'
        && data.createdAt == request.time
        && data.keys().hasAll(['userId', 'guests', 'date', 'time', 'zone', 'customerName', 'customerEmail', 'status', 'createdAt'])
        && data.keys().size() >= 9;
    }

    // --- User Profiles (Placeholder if needed) ---
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }
  }
}
