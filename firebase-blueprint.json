{
  "entities": {
    "Order": {
      "title": "Order",
      "description": "A coffee order placed by a user",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "UID of the user who placed the order" },
        "items": { "type": "array", "description": "List of items in the order" },
        "total": { "type": "number", "description": "Total price of the order" },
        "status": { "type": "string", "enum": ["preparing", "completed"], "description": "Current status of the order" },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the order was created" },
        "metadata": { "type": "object", "description": "Additional order info" }
      },
      "required": ["userId", "items", "total", "status", "createdAt"]
    },
    "Reservation": {
      "title": "Reservation",
      "description": "A table reservation",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "UID of the user" },
        "type": { "type": "string", "description": "Type of reservation (e.g., table)" },
        "guests": { "type": "integer", "description": "Number of guests" },
        "date": { "type": "string", "description": "Reservation date" },
        "time": { "type": "string", "description": "Reservation time" },
        "zone": { "type": "string", "description": "Selected zone" },
        "customerName": { "type": "string", "description": "Name of the customer" },
        "customerEmail": { "type": "string", "description": "Email of the customer" },
        "requirements": { "type": "string", "description": "Special requests" },
        "status": { "type": "string", "description": "Status of the reservation" },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the reservation was created" }
      },
      "required": ["userId", "guests", "date", "time", "zone", "customerName", "customerEmail", "status", "createdAt"]
    }
  },
  "firestore": {
    "orders/{orderId}": {
      "schema": "Order",
      "description": "Collection of coffee orders"
    },
    "reservations/{reservationId}": {
      "schema": "Reservation",
      "description": "Collection of table reservations"
    }
  }
}
